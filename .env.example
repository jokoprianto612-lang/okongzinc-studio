# ============================================================================
# OkongzINC Studio - environment template
# Copy to .env and fill in what you actually have. Nothing here is strictly
# required: the default image provider (Pollinations) needs no credentials.
# ============================================================================

# --- server ---
PORT=8787
NODE_ENV=development

# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# Where generated media is written. Relative paths resolve from server/.
STORAGE_DIR=./storage

# Max concurrent generation jobs.
MAX_CONCURRENT_JOBS=2

# Optional shared secret. When set, every /api request must send
# `X-Api-Key: <value>`.
#
# SECURITY: leave this blank ONLY for local, single-user development. The API
# is fully unauthenticated when blank - anyone who can reach the port can
# spend your provider quota. Set it before binding to a public interface.
API_KEY=

# ============================================================================
# Providers - all optional, each independently toggled.
# A provider is only exposed by /api/providers when its config is present.
# ============================================================================

# --- Pollinations (image) -------------------------------------------------
# Free, no API key, no signup. Default image provider and the only one that
# works with zero configuration.
POLLINATIONS_ENABLED=true
POLLINATIONS_BASE_URL=https://image.pollinations.ai

# --- fal.ai (image + video + 3D) — RECOMMENDED ----------------------------
# One key unlocks all three modalities. fal already hosts the exact models the
# Modal workers below would self-host, at roughly a tenth of the cost, with no
# weight download and no idle storage bill.
#
#   Get a key:  https://fal.ai/dashboard/keys
#
# Prices verified 2026-08-01 from fal's own model metadata:
#   LongCat-Video 480p distilled   $0.005 / generated second  (6s clip ~= $0.03)
#   LongCat-Video 720p distilled   $0.01
#   LongCat-Video 480p full        $0.025
#   Seedance 2.0 mini              ~$0.072/s @480p
#   Seedance 2.0                   ~$0.303/s @720p
#   TRELLIS-2                      $0.25 @512p, $0.30 @1024p
#   LongCat-Image                  per-image
FAL_KEY=

# --- Premium tier (admin opt-in) -----------------------------------------
# The flagship models cost DOLLARS per render, not cents, and they use the same
# FAL_KEY as the cheap providers above. Without a separate switch a user
# browsing the model dropdown could spend a dollar per click by accident, so
# they are off by default.
#
# Providers behind this switch (verified prices, 2026-08-02):
#   Veo 3.1            $0.03-$0.60 per generated second (Lite -> full, 4K)
#   Kling v3           $0.084-$0.168 per generated second
#   FLUX.2 Pro         $0.03 first megapixel + $0.015 per extra
#   Nano Banana Pro    $0.15 per image ($0.30 at 4K)
#   Seedream 5.0 Pro   $0.0675 per image ($0.135 at 2K)
#   Ideogram V3        $0.03 TURBO / $0.06 BALANCED / $0.09 QUALITY
#   Topaz Upscale      $0.08 up to 24MP
#   Tripo3D v2.5       $0.20-$0.45 per mesh
#   Hunyuan3D v2       billed per compute second
#
# When false, every premium provider reports available:false with that reason
# shown in the UI - the same way a missing key behaves. Nothing disappears.
PREMIUM_ENABLED=false

# Hard ceiling in USD on the vendor-quoted cost of ONE render. Checked BEFORE
# the request is submitted, so an over-budget job costs nothing. 0 disables it.
# An 8s Veo 3.1 clip at 4K with audio is $4.80, which is why this defaults to 5.
PREMIUM_MAX_COST_PER_JOB_USD=5

# --- Google Gemini / Veo (image + video) ---------------------------------
# One key covers both. Get it at https://aistudio.google.com/apikey
# NOTE: free-tier image/video quota is small. Once spent, the API returns
# HTTP 429 RESOURCE_EXHAUSTED - that is a billing state, not an app bug.
GOOGLE_API_KEY=
GOOGLE_IMAGE_MODEL=gemini-3.1-flash-image
GOOGLE_VIDEO_MODEL=veo-3.1-generate-preview

# --- Modal (3D via microsoft/TRELLIS.2) ----------------------------------
# TRELLIS.2 requires an NVIDIA GPU with >=24GB VRAM, so it runs remotely on
# Modal rather than on your machine. Deploy modal/trellis_app.py first, then
# paste the web endpoint URL Modal prints. See docs/ARCHITECTURE.md.
MODAL_TRELLIS_URL=
MODAL_TRELLIS_TOKEN=

# --- Modal (video via meituan-longcat/LongCat-Video) ---------------------
# Self-hosted 13.6B open-weights video model: text-to-video, image-to-video,
# and native video continuation. No per-request quota, but ~83 GB of weights
# and an 80GB-class GPU, so it runs on Modal:
#
#   modal run modal/longcat_app.py::download_weights   # ~83 GB, once
#   modal deploy modal/longcat_app.py
#
# Then paste the printed endpoint below.
MODAL_LONGCAT_URL=
MODAL_LONGCAT_TOKEN=

# ============================================================================
# Reach - reference research (no configuration required)
# ============================================================================
# Turns a URL into clean markdown so a prompt can be grounded in a real page.
# Two backends, tried in order:
#   1. agent-reach CLI (github.com/Panniantong/Agent-Reach) when on PATH -
#      adds Twitter/X, Reddit, YouTube subtitles, Bilibili, XiaoHongShu.
#      Install:  pip install https://github.com/Panniantong/agent-reach/archive/main.zip
#                agent-reach install --env=auto
#   2. Jina Reader (r.jina.ai) - zero install, no key, any public URL.
# Backend 2 always works, so Reach is on by default.
REACH_ENABLED=true

# Absolute path to the agent-reach binary. Empty = look on PATH.
AGENT_REACH_BIN=

# Jina Reader endpoint and optional key (a key only raises rate limits).
JINA_READER_URL=https://r.jina.ai
JINA_API_KEY=

# Characters of extracted text kept before truncation, and the fetch timeout.
REACH_MAX_CHARS=12000
REACH_TIMEOUT_MS=60000

# ============================================================================
# Shot composer and prompting guidance — no configuration, nothing to set
# ============================================================================
# GET /api/shots     22 cinematography categories, 118 terms, each with a
#                    reference clip. Adapted from ilkerzg/awesome-video-prompts.
# GET /api/guidance  per-model prompting tips and length ceilings.
# Both are static data compiled into the server, served with a 1h cache header.

# --- OpenAI-compatible image endpoint (optional) -------------------------
# Any endpoint speaking POST /v1/images/generations.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_IMAGE_MODEL=gpt-image-1
