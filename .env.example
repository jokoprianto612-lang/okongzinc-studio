# ============================================================================
# OkongzINC Studio - environment template
# Copy to .env and fill in what you actually have. Nothing here is strictly
# required: the default image provider (Pollinations) needs no credentials.
# ============================================================================

# --- server ---
PORT=8787
NODE_ENV=development

# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# Where generated media is written. Relative paths resolve from server/.
STORAGE_DIR=./storage

# Max concurrent generation jobs.
MAX_CONCURRENT_JOBS=2

# Optional shared secret. When set, every /api request must send
# `X-Api-Key: <value>`.
#
# SECURITY: leave this blank ONLY for local, single-user development. The API
# is fully unauthenticated when blank - anyone who can reach the port can
# spend your provider quota. Set it before binding to a public interface.
API_KEY=

# ============================================================================
# Providers - all optional, each independently toggled.
# A provider is only exposed by /api/providers when its config is present.
# ============================================================================

# --- Pollinations (image) -------------------------------------------------
# Free, no API key, no signup. Default image provider and the only one that
# works with zero configuration.
POLLINATIONS_ENABLED=true
POLLINATIONS_BASE_URL=https://image.pollinations.ai

# --- Google Gemini / Veo (image + video) ---------------------------------
# One key covers both. Get it at https://aistudio.google.com/apikey
# NOTE: free-tier image/video quota is small. Once spent, the API returns
# HTTP 429 RESOURCE_EXHAUSTED - that is a billing state, not an app bug.
GOOGLE_API_KEY=
GOOGLE_IMAGE_MODEL=gemini-3.1-flash-image
GOOGLE_VIDEO_MODEL=veo-3.1-generate-preview

# --- Modal (3D via microsoft/TRELLIS.2) ----------------------------------
# TRELLIS.2 requires an NVIDIA GPU with >=24GB VRAM, so it runs remotely on
# Modal rather than on your machine. Deploy modal/trellis_app.py first, then
# paste the web endpoint URL Modal prints. See docs/ARCHITECTURE.md.
MODAL_TRELLIS_URL=
MODAL_TRELLIS_TOKEN=

# --- OpenAI-compatible image endpoint (optional) -------------------------
# Any endpoint speaking POST /v1/images/generations.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_IMAGE_MODEL=gpt-image-1
